generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PanelStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum MapObjectType {
  STORE
  TOILET
  ATM
  ENTRANCE
  EXIT
  ELEVATOR
  ESCALATOR
  STAIRS
  PARKING
  INFO
  FOODCOURT
  REST_ZONE
  AD_ZONE
}

enum RouteNodeType {
  ROUTE_POINT
  ENTRANCE
  EXIT
  PANEL
  STORE_ANCHOR
  ELEVATOR
  ESCALATOR
  STAIRS
  TOILET
  INFO_DESK
  OTHER
}

enum RouteEdgeType {
  WALKWAY
  STAIRS
  ELEVATOR
  ESCALATOR
  TOILET
  ENTRANCE
  EXIT
  OTHER
}

enum FileAssetKind {
  IMAGE
  VIDEO
  MODEL_3D
  DOCUMENT
  OTHER
}

enum AdPlacement {
  HOME_PANEL_BANNER
  STORE_CARD_BANNER
  PROMOTIONS_BANNER
  MOBILE_HOME_BANNER
}

enum AdTargetType {
  STORE
  PROMOTION
  URL
  NONE
}

enum AnalyticsSource {
  PANEL
  MOBILE
  ADMIN
}

enum AnalyticsEventType {
  SESSION_STARTED
  SESSION_ENDED
  SESSION_RESET
  SEARCH_QUERY
  CATEGORY_SELECTED
  STORE_SELECTED
  STORE_CARD_VIEWED
  ROUTE_BUILT
  QR_SCANNED
  PROMOTION_VIEWED
  AD_IMPRESSION
  AD_CLICK
  MOBILE_OPENED
  PANEL_USED
  DATA_LOAD_ERROR
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model User {
  id                String      @id @default(cuid())
  email             String      @unique
  passwordHash      String?
  name              String?
  phone             String?
  isActive          Boolean     @default(true)
  roleId            String
  role              Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  lastLoginAt       DateTime?
  files             FileAsset[] @relation("UploadedFiles")
  refreshTokens     RefreshToken[]
  createdPromotions Promotion[] @relation("PromotionCreatedBy")
  updatedPromotions Promotion[] @relation("PromotionUpdatedBy")
  createdAdCampaigns           AdCampaign[]           @relation("AdCampaignCreatedBy")
  updatedAdCampaigns           AdCampaign[]           @relation("AdCampaignUpdatedBy")
  createdAdCreatives           AdCreative[]           @relation("AdCreativeCreatedBy")
  updatedAdCreatives           AdCreative[]           @relation("AdCreativeUpdatedBy")
  createdAdSlots               AdSlot[]               @relation("AdSlotCreatedBy")
  updatedAdSlots               AdSlot[]               @relation("AdSlotUpdatedBy")
  createdAdCampaignAssignments AdCampaignAssignment[] @relation("AdCampaignAssignmentCreatedBy")
  updatedAdCampaignAssignments AdCampaignAssignment[] @relation("AdCampaignAssignmentUpdatedBy")
  createdHeaderBanners         HeaderBanner[]         @relation("HeaderBannerCreatedBy")
  updatedHeaderBanners         HeaderBanner[]         @relation("HeaderBannerUpdatedBy")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([roleId])
  @@index([isActive])
}

model Category {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  description      String?
  icon             String?
  sortOrder        Int              @default(0)
  isActive         Boolean          @default(true)
  stores           Store[]          @relation("StoreMainCategory")
  additionalStores Store[]          @relation("StoreAdditionalCategories")
  mapObjects       MapObject[]
  analyticsEvents  AnalyticsEvent[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([slug])
  @@index([isActive, sortOrder])
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  legalName   String?
  description String?
  phone       String?
  email       String?
  website     String?
  logoAssetId String?
  logoAsset   FileAsset?   @relation("TenantLogoAsset", fields: [logoAssetId], references: [id], onDelete: SetNull)
  isActive    Boolean      @default(true)
  stores      Store[]
  promotions  Promotion[]
  campaigns   AdCampaign[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([name])
  @@index([isActive])
}

model Store {
  id                   String           @id @default(cuid())
  tenantId             String?
  tenant               Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  categoryId           String?
  category             Category?        @relation("StoreMainCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  additionalCategories Category[]       @relation("StoreAdditionalCategories")
  floorId              String?
  floor                Floor?           @relation(fields: [floorId], references: [id], onDelete: SetNull)
  name                 String
  slug                 String           @unique
  description          String?
  roomNumber           String?
  phone                String?
  email                String?
  website              String?
  workingHours         Json?
  searchKeywords       String?
  logoAssetId          String?
  logoAsset            FileAsset?       @relation("StoreLogoAsset", fields: [logoAssetId], references: [id], onDelete: SetNull)
  coverAssetId         String?
  coverAsset           FileAsset?       @relation("StoreCoverAsset", fields: [coverAssetId], references: [id], onDelete: SetNull)
  isActive             Boolean          @default(true)
  isVisible            Boolean          @default(true)
  mapObjects           MapObject[]
  floorIcons           FloorIcon[]
  promotions           Promotion[]
  targetedCampaigns    AdCampaign[]     @relation("AdCampaignTargetStore")
  analyticsEvents      AnalyticsEvent[]
  headerBanners        HeaderBanner[]   @relation("HeaderBannerTargetStore")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([tenantId])
  @@index([categoryId])
  @@index([floorId])
  @@index([isActive, isVisible])
  @@index([name])
}

model Floor {
  id           String      @id @default(cuid())
  number       Int         @unique
  name         String
  description  String?
  sortOrder    Int         @default(0)
  mapImageUrl  String?
  width        Float?
  height       Float?
  depth        Int?
  unit         String?
  metadata     Json?
  mapAssetId   String?
  mapAsset     FileAsset?  @relation("FloorMapAsset", fields: [mapAssetId], references: [id], onDelete: SetNull)
  modelAssetId String?
  modelAsset   FileAsset?  @relation("FloorModelAsset", fields: [modelAssetId], references: [id], onDelete: SetNull)
  isActive     Boolean     @default(true)
  stores       Store[]
  mapObjects   MapObject[]
  panels       Panel[]
  routeNodes   RouteNode[]
  routeEdges   RouteEdge[]
  floorTextures FloorTexture[]
  floorIcons   FloorIcon[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([number])
  @@index([isActive, sortOrder])
}

model MapObject {
  id               String        @id @default(cuid())
  type             MapObjectType
  name             String
  description      String?
  floorId          String
  floor            Floor         @relation(fields: [floorId], references: [id], onDelete: Cascade)
  storeId          String?
  store            Store?        @relation(fields: [storeId], references: [id], onDelete: SetNull)
  categoryId       String?
  category         Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  x                Float?
  y                Float?
  z                Int?
  width            Float?
  height           Float?
  rotationX        Float?
  rotationY        Float?
  rotationZ        Float?
  scaleX           Float?
  scaleY           Float?
  scaleZ           Float?
  externalObjectId String?
  geometry         Json?
  metadata         Json?
  sortOrder        Int           @default(0)
  isActive         Boolean       @default(true)
  routeNodes       RouteNode[]   @relation("RouteNodeMapObject")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([floorId])
  @@index([floorId, type])
  @@index([storeId])
  @@index([categoryId])
  @@index([externalObjectId])
  @@index([isActive])
}

model Panel {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  description     String?
  status          PanelStatus      @default(OFFLINE)
  floorId         String?
  floor           Floor?           @relation(fields: [floorId], references: [id], onDelete: SetNull)
  routeNodeId     String?          @unique
  routeNode       RouteNode?       @relation("PanelStartNode", fields: [routeNodeId], references: [id], onDelete: SetNull)
  location        Json?
  appVersion      String?
  lastSeenAt      DateTime?
  isActive        Boolean          @default(true)
  adSlots         AdSlot[]
  analyticsEvents AnalyticsEvent[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
  @@index([floorId])
  @@index([lastSeenAt])
  @@index([isActive])
}

model RouteNode {
  id          String        @id @default(cuid())
  floorId     String
  floor       Floor         @relation(fields: [floorId], references: [id], onDelete: Cascade)
  type        RouteNodeType @default(ROUTE_POINT)
  name        String?
  code        String?
  x           Int
  y           Int
  z           Int?
  rotationX   Float?
  rotationY   Float?
  rotationZ   Float?
  scaleX      Float?
  scaleY      Float?
  scaleZ      Float?
  mapObjectId String?
  mapObject   MapObject?    @relation("RouteNodeMapObject", fields: [mapObjectId], references: [id], onDelete: SetNull)
  metadata    Json?
  sortOrder   Int           @default(0)
  isActive    Boolean       @default(true)
  outgoing    RouteEdge[]   @relation("RouteEdgeFrom")
  incoming    RouteEdge[]   @relation("RouteEdgeTo")
  panel       Panel?        @relation("PanelStartNode")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([floorId])
  @@index([floorId, type])
  @@index([code])
  @@index([mapObjectId])
  @@index([isActive])
}

model RouteEdge {
  id              String    @id @default(cuid())
  floorId         String
  floor           Floor     @relation(fields: [floorId], references: [id], onDelete: Cascade)
  fromNodeId      String
  fromNode        RouteNode @relation("RouteEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId        String
  toNode          RouteNode @relation("RouteEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  type            RouteEdgeType @default(WALKWAY)
  distance        Int?
  weight          Int?
  isBidirectional Boolean   @default(true)
  metadata        Json?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  usage           RouteEdgeUsage[]

  @@unique([fromNodeId, toNodeId])
  @@index([floorId])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@index([floorId, isActive])
  @@index([isActive])
}

model RouteEdgeUsage {
  id           String      @id @default(cuid())
  edgeId       String      @unique
  edge         RouteEdge   @relation(fields: [edgeId], references: [id], onDelete: Cascade)
  count        Int         @default(0)
  windowStart  DateTime
  lastUsedAt   DateTime
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([windowStart])
  @@index([lastUsedAt])
}

model Promotion {
  id                String           @id @default(cuid())
  title             String
  slug              String           @unique
  description       String?
  terms             String?          @db.Text
  buttonText        String?
  buttonUrl         String?
  tenantId          String?
  tenant            Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  storeId           String?
  store             Store?           @relation(fields: [storeId], references: [id], onDelete: SetNull)
  imageAssetId      String?
  imageAsset        FileAsset?       @relation("PromotionImageAsset", fields: [imageAssetId], references: [id], onDelete: SetNull)
  startsAt          DateTime?
  endsAt            DateTime?
  isActive          Boolean          @default(true)
  sortOrder         Int              @default(0)
  metadata          Json?
  deletedAt         DateTime?
  createdById       String?
  createdBy         User?            @relation("PromotionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById       String?
  updatedBy         User?            @relation("PromotionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  targetedCampaigns AdCampaign[]     @relation("AdCampaignTargetPromotion")
  analyticsEvents   AnalyticsEvent[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([imageAssetId])
  @@index([storeId, isActive, startsAt, endsAt])
  @@index([tenantId, isActive, startsAt, endsAt])
  @@index([isActive, startsAt, endsAt])
  @@index([deletedAt])
  @@index([createdById])
  @@index([updatedById])
}

model AdCampaign {
  id                String           @id @default(cuid())
  name              String
  description       String?
  tenantId          String?
  tenant            Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  placement         AdPlacement
  targetType        AdTargetType     @default(NONE)
  targetStoreId     String?
  targetStore       Store?           @relation("AdCampaignTargetStore", fields: [targetStoreId], references: [id], onDelete: SetNull)
  targetPromotionId String?
  targetPromotion   Promotion?       @relation("AdCampaignTargetPromotion", fields: [targetPromotionId], references: [id], onDelete: SetNull)
  targetUrl         String?
  startsAt          DateTime?
  endsAt            DateTime?
  priority          Int              @default(0)
  impressionLimit   Int?
  isActive          Boolean          @default(true)
  metadata          Json?
  deletedAt         DateTime?
  createdById       String?
  createdBy         User?            @relation("AdCampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById       String?
  updatedBy         User?            @relation("AdCampaignUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  creatives         AdCreative[]
  assignments       AdCampaignAssignment[]
  analyticsEvents   AnalyticsEvent[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([tenantId])
  @@index([placement])
  @@index([targetType])
  @@index([targetStoreId])
  @@index([targetPromotionId])
  @@index([isActive, startsAt, endsAt])
  @@index([priority])
  @@index([deletedAt])
  @@index([createdById])
  @@index([updatedById])
}

model AdCreative {
  id              String           @id @default(cuid())
  campaignId      String
  campaign        AdCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  assetId         String?
  asset           FileAsset?       @relation("AdCreativeFileAsset", fields: [assetId], references: [id], onDelete: SetNull)
  title           String?
  description     String?
  altText         String?
  ctaText         String?
  isActive        Boolean          @default(true)
  sortOrder       Int              @default(0)
  metadata        Json?
  deletedAt       DateTime?
  createdById     String?
  createdBy       User?            @relation("AdCreativeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById     String?
  updatedBy       User?            @relation("AdCreativeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  analyticsEvents AnalyticsEvent[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([campaignId])
  @@index([assetId])
  @@index([isActive, sortOrder])
  @@index([deletedAt])
  @@index([createdById])
  @@index([updatedById])
}

model AnalyticsEvent {
id            String             @id @default(cuid())
  clientEventId String?            @unique
  type          AnalyticsEventType
  source        AnalyticsSource
  sessionId     String?
  panelId       String?
  panel         Panel?             @relation(fields: [panelId], references: [id], onDelete: SetNull)
  adSlotId      String?
  adSlot        AdSlot?            @relation(fields: [adSlotId], references: [id], onDelete: SetNull)
  storeId       String?
  store         Store?             @relation(fields: [storeId], references: [id], onDelete: SetNull)
  categoryId    String?
  category      Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  promotionId   String?
  promotion     Promotion?         @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  campaignId    String?
  campaign      AdCampaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  creativeId    String?
  creative      AdCreative?        @relation(fields: [creativeId], references: [id], onDelete: SetNull)
  query         String?
  qrToken       String?
  deviceData    Json?
  payload       Json?
  createdAt     DateTime           @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([source, createdAt])
  @@index([sessionId])
  @@index([panelId, createdAt])
  @@index([adSlotId, createdAt])
  @@index([storeId, createdAt])
  @@index([categoryId, createdAt])
  @@index([promotionId, createdAt])
  @@index([campaignId, createdAt])
  @@index([creativeId, createdAt])
}

model FileAsset {
  id               String        @id @default(cuid())
  filename         String
  originalName     String?
  mimeType         String?
  size             Int?
  url              String
  path             String?
  provider         String?
  kind             FileAssetKind @default(OTHER)
  isActive         Boolean       @default(true)
  metadata         Json?
  uploadedById     String?
  uploadedBy       User?         @relation("UploadedFiles", fields: [uploadedById], references: [id], onDelete: SetNull)
  tenantLogos      Tenant[]      @relation("TenantLogoAsset")
  storeLogos       Store[]       @relation("StoreLogoAsset")
  storeCovers      Store[]       @relation("StoreCoverAsset")
  floorMaps        Floor[]       @relation("FloorMapAsset")
  floorModels      Floor[]       @relation("FloorModelAsset")
  floorTextures    FloorTexture[]
  promotionImages  Promotion[]   @relation("PromotionImageAsset")
  adCreativeAssets AdCreative[]  @relation("AdCreativeFileAsset")
  headerBannerAssets HeaderBanner[] @relation("HeaderBannerAsset")
  floorIcons       FloorIcon[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([uploadedById])
  @@index([mimeType])
  @@index([isActive])
  @@index([kind])
  @@index([createdAt])
}

model FloorTexture {
  id        String         @id @default(cuid())
  floorId   String
  floor     Floor          @relation(fields: [floorId], references: [id], onDelete: Cascade)
  assetId   String
  asset     FileAsset      @relation(fields: [assetId], references: [id])
  targetMesh String
  materialSlot String?
  opacity   Float         @default(1)
  blendMode String         @default("normal")
  positionX Float         @default(0)
  positionY Float         @default(0)
  scaleX    Float         @default(1)
  scaleY    Float         @default(1)
  rotation  Float         @default(0)
  sortOrder Int           @default(0)
  isActive  Boolean       @default(true)
  metadata  Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([floorId])
  @@index([assetId])
  @@index([floorId, isActive, sortOrder])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([isPublic])
}

model SharedRoute {
  id          String   @id @default(cuid())
  token       String   @unique
  payload     Json
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([token])
  @@index([expiresAt])
}

model FloorIcon {
  id        String    @id @default(cuid())
  name      String
  floorId   String
  floor     Floor     @relation(fields: [floorId], references: [id], onDelete: Cascade)
  storeId   String?
  store     Store?    @relation(fields: [storeId], references: [id], onDelete: SetNull)
  assetId   String
  asset     FileAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  x         Float
  y         Float
  z         Float     @default(0)
  rotation  Float     @default(0)
  scaleX    Float     @default(1)
  scaleY    Float     @default(1)
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([floorId])
  @@index([storeId])
  @@index([assetId])
}

model AdSlot {
  id              String                 @id @default(cuid())
  code            String                 @unique
  name            String
  description     String?                @db.Text
  placement       AdPlacement
  panelId         String?
  panel           Panel?                 @relation(fields: [panelId], references: [id], onDelete: SetNull)
  sortOrder       Int                    @default(0)
  isActive        Boolean                @default(true)
  metadata        Json?
  deletedAt       DateTime?
  createdById     String?
  createdBy       User?                  @relation("AdSlotCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById     String?
  updatedBy       User?                  @relation("AdSlotUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  assignments     AdCampaignAssignment[]
  analyticsEvents AnalyticsEvent[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([placement, isActive, sortOrder])
  @@index([panelId, isActive])
  @@index([deletedAt])
  @@index([createdById])
  @@index([updatedById])
}

model AdCampaignAssignment {
  id          String     @id @default(cuid())
  campaignId  String
  campaign    AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  slotId      String
  slot        AdSlot     @relation(fields: [slotId], references: [id], onDelete: Cascade)
  isActive    Boolean    @default(true)
  deletedAt   DateTime?
  createdById String?
  createdBy   User?      @relation("AdCampaignAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?      @relation("AdCampaignAssignmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([campaignId, slotId])
  @@index([campaignId, isActive, deletedAt])
  @@index([slotId, isActive, deletedAt])
  @@index([deletedAt])
  @@index([createdById])
  @@index([updatedById])
}

model HeaderBanner {
  id           String   @id @default(cuid())
  title        String
  subtitle     String?
  linkUrl      String?
  assetId      String?
  asset        FileAsset? @relation("HeaderBannerAsset", fields: [assetId], references: [id], onDelete: SetNull)
  targetStoreId String?
  targetStore  Store?    @relation("HeaderBannerTargetStore", fields: [targetStoreId], references: [id], onDelete: SetNull)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  placement    String   @default("HEADER")
  deletedAt    DateTime?
  createdById  String?
  createdBy    User?    @relation("HeaderBannerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById  String?
  updatedBy    User?    @relation("HeaderBannerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([placement])
  @@index([deletedAt])
  @@index([createdById])
  @@index([updatedById])
  @@index([targetStoreId])
}
