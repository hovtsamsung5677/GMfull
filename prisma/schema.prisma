generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@index([name])
}

model User {
  id                           String                 @id @default(cuid())
  email                        String                 @unique
  passwordHash                 String?
  name                         String?
  phone                        String?
  isActive                     Boolean                @default(true)
  roleId                       String
  lastLoginAt                  DateTime?
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  createdAdCampaigns           AdCampaign[]           @relation("AdCampaignCreatedBy")
  updatedAdCampaigns           AdCampaign[]           @relation("AdCampaignUpdatedBy")
  createdAdCampaignAssignments AdCampaignAssignment[] @relation("AdCampaignAssignmentCreatedBy")
  updatedAdCampaignAssignments AdCampaignAssignment[] @relation("AdCampaignAssignmentUpdatedBy")
  createdAdCreatives           AdCreative[]           @relation("AdCreativeCreatedBy")
  updatedAdCreatives           AdCreative[]           @relation("AdCreativeUpdatedBy")
  createdAdSlots               AdSlot[]               @relation("AdSlotCreatedBy")
  updatedAdSlots               AdSlot[]               @relation("AdSlotUpdatedBy")
  files                        FileAsset[]            @relation("UploadedFiles")
  createdHeaderBanners         HeaderBanner[]         @relation("HeaderBannerCreatedBy")
  updatedHeaderBanners         HeaderBanner[]         @relation("HeaderBannerUpdatedBy")
  createdPromotions            Promotion[]            @relation("PromotionCreatedBy")
  updatedPromotions            Promotion[]            @relation("PromotionUpdatedBy")
  refreshTokens                RefreshToken[]
  role                         Role                   @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@index([isActive])
}

model Category {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  description      String?
  icon             String?
  sortOrder        Int              @default(0)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  analyticsEvents  AnalyticsEvent[]
  mapObjects       MapObject[]
  stores           Store[]          @relation("StoreMainCategory")
  additionalStores Store[]          @relation("StoreAdditionalCategories")

  @@index([slug])
  @@index([isActive, sortOrder])
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  legalName   String?
  description String?
  phone       String?
  email       String?
  website     String?
  logoAssetId String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  campaigns   AdCampaign[]
  promotions  Promotion[]
  stores      Store[]
  logoAsset   FileAsset?   @relation("TenantLogoAsset", fields: [logoAssetId], references: [id])

  @@index([name])
  @@index([isActive])
}

model Store {
  id                   String           @id @default(cuid())
  tenantId             String?
  categoryId           String?
  floorId              String?
  name                 String
  slug                 String           @unique
  description          String?
  roomNumber           String?
  phone                String?
  email                String?
  website              String?
  workingHours         Json?
  searchKeywords       String?
  logoAssetId          String?
  coverAssetId         String?
  isActive             Boolean          @default(true)
  isVisible            Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  targetedCampaigns    AdCampaign[]     @relation("AdCampaignTargetStore")
  analyticsEvents      AnalyticsEvent[]
  floorIcons           FloorIcon[]
  headerBanners        HeaderBanner[]   @relation("HeaderBannerTargetStore")
  mapObjects           MapObject[]
  promotions           Promotion[]
  category             Category?        @relation("StoreMainCategory", fields: [categoryId], references: [id])
  coverAsset           FileAsset?       @relation("StoreCoverAsset", fields: [coverAssetId], references: [id])
  floor                Floor?           @relation(fields: [floorId], references: [id])
  logoAsset            FileAsset?       @relation("StoreLogoAsset", fields: [logoAssetId], references: [id])
  tenant               Tenant?          @relation(fields: [tenantId], references: [id])
  additionalCategories Category[]       @relation("StoreAdditionalCategories")

  @@index([tenantId])
  @@index([categoryId])
  @@index([floorId])
  @@index([isActive, isVisible])
  @@index([name])
}

model Floor {
  id            String         @id @default(cuid())
  number        Int            @unique
  name          String
  description   String?
  sortOrder     Int            @default(0)
  mapAssetId    String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  mapImageUrl   String?
  width         Float?
  height        Float?
  depth         Int?
  unit          String?
  metadata      Json?
  modelAssetId  String?
  mapAsset      FileAsset?     @relation("FloorMapAsset", fields: [mapAssetId], references: [id])
  modelAsset    FileAsset?     @relation("FloorModelAsset", fields: [modelAssetId], references: [id])
  floorIcons    FloorIcon[]
  floorTextures FloorTexture[]
  mapObjects    MapObject[]
  panels        Panel[]
  routeEdges    RouteEdge[]
  routeNodes    RouteNode[]
  stores        Store[]

  @@index([number])
  @@index([isActive, sortOrder])
}

model MapObject {
  id               String        @id @default(cuid())
  type             MapObjectType
  name             String
  description      String?
  floorId          String
  storeId          String?
  categoryId       String?
  x                Float?
  y                Float?
  width            Float?
  height           Float?
  geometry         Json?
  metadata         Json?
  sortOrder        Int           @default(0)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  z                Int?
  rotationX        Float?
  rotationY        Float?
  rotationZ        Float?
  scaleX           Float?
  scaleY           Float?
  scaleZ           Float?
  externalObjectId String?
  category         Category?     @relation(fields: [categoryId], references: [id])
  floor            Floor         @relation(fields: [floorId], references: [id], onDelete: Cascade)
  store            Store?        @relation(fields: [storeId], references: [id])
  routeNodes       RouteNode[]   @relation("RouteNodeMapObject")

  @@index([floorId])
  @@index([floorId, type])
  @@index([storeId])
  @@index([categoryId])
  @@index([externalObjectId])
  @@index([isActive])
}

model Panel {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  description     String?
  status          PanelStatus      @default(OFFLINE)
  floorId         String?
  routeNodeId     String?          @unique
  location        Json?
  appVersion      String?
  lastSeenAt      DateTime?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  adSlots         AdSlot[]
  analyticsEvents AnalyticsEvent[]
  floor           Floor?           @relation(fields: [floorId], references: [id])
  routeNode       RouteNode?       @relation("PanelStartNode", fields: [routeNodeId], references: [id])

  @@index([status])
  @@index([floorId])
  @@index([lastSeenAt])
  @@index([isActive])
}

model RouteNode {
  id          String        @id @default(cuid())
  type        RouteNodeType @default(ROUTE_POINT)
  name        String?
  floorId     String
  x           Int
  y           Int
  metadata    Json?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  code        String?
  sortOrder   Int           @default(0)
  z           Int?
  rotationX   Float?
  rotationY   Float?
  rotationZ   Float?
  scaleX      Float?
  scaleY      Float?
  scaleZ      Float?
  mapObjectId String?
  panel       Panel?        @relation("PanelStartNode")
  outgoing    RouteEdge[]   @relation("RouteEdgeFrom")
  incoming    RouteEdge[]   @relation("RouteEdgeTo")
  floor       Floor         @relation(fields: [floorId], references: [id], onDelete: Cascade)
  mapObject   MapObject?    @relation("RouteNodeMapObject", fields: [mapObjectId], references: [id])

  @@index([floorId])
  @@index([floorId, type])
  @@index([code])
  @@index([mapObjectId])
  @@index([isActive])
}

model RouteEdge {
  id              String          @id @default(cuid())
  fromNodeId      String
  toNodeId        String
  distance        Int?
  weight          Int?
  isActive        Boolean         @default(true)
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  floorId         String
  isBidirectional Boolean         @default(true)
  type            RouteEdgeType   @default(WALKWAY)
  floor           Floor           @relation(fields: [floorId], references: [id], onDelete: Cascade)
  fromNode        RouteNode       @relation("RouteEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode          RouteNode       @relation("RouteEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  usage           RouteEdgeUsage?

  @@unique([fromNodeId, toNodeId])
  @@index([floorId])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@index([floorId, isActive])
  @@index([isActive])
}

model RouteEdgeUsage {
  id          String    @id @default(cuid())
  edgeId      String    @unique
  count       Int       @default(0)
  windowStart DateTime
  lastUsedAt  DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  edge        RouteEdge @relation(fields: [edgeId], references: [id], onDelete: Cascade)

  @@index([windowStart])
  @@index([lastUsedAt])
}

model Promotion {
  id                String           @id @default(cuid())
  title             String
  description       String?
  tenantId          String?
  storeId           String?
  imageAssetId      String?
  startsAt          DateTime?
  endsAt            DateTime?
  isActive          Boolean          @default(true)
  sortOrder         Int              @default(0)
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  slug              String           @unique
  terms             String?
  buttonText        String?
  buttonUrl         String?
  deletedAt         DateTime?
  createdById       String?
  updatedById       String?
  targetedCampaigns AdCampaign[]     @relation("AdCampaignTargetPromotion")
  analyticsEvents   AnalyticsEvent[]
  createdBy         User?            @relation("PromotionCreatedBy", fields: [createdById], references: [id])
  imageAsset        FileAsset?       @relation("PromotionImageAsset", fields: [imageAssetId], references: [id])
  store             Store?           @relation(fields: [storeId], references: [id])
  tenant            Tenant?          @relation(fields: [tenantId], references: [id])
  updatedBy         User?            @relation("PromotionUpdatedBy", fields: [updatedById], references: [id])

  @@index([imageAssetId])
  @@index([storeId, isActive, startsAt, endsAt])
  @@index([tenantId, isActive, startsAt, endsAt])
  @@index([isActive, startsAt, endsAt])
  @@index([deletedAt])
  @@index([createdById])
  @@index([updatedById])
}

model AdCampaign {
  id                String                 @id @default(cuid())
  name              String
  description       String?
  tenantId          String?
  placement         AdPlacement
  targetType        AdTargetType           @default(NONE)
  targetStoreId     String?
  targetPromotionId String?
  targetUrl         String?
  startsAt          DateTime?
  endsAt            DateTime?
  priority          Int                    @default(0)
  impressionLimit   Int?
  isActive          Boolean                @default(true)
  metadata          Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  createdById       String?
  deletedAt         DateTime?
  updatedById       String?
  createdBy         User?                  @relation("AdCampaignCreatedBy", fields: [createdById], references: [id])
  targetPromotion   Promotion?             @relation("AdCampaignTargetPromotion", fields: [targetPromotionId], references: [id])
  targetStore       Store?                 @relation("AdCampaignTargetStore", fields: [targetStoreId], references: [id])
  tenant            Tenant?                @relation(fields: [tenantId], references: [id])
  updatedBy         User?                  @relation("AdCampaignUpdatedBy", fields: [updatedById], references: [id])
  assignments       AdCampaignAssignment[]
  creatives         AdCreative[]
  analyticsEvents   AnalyticsEvent[]

  @@index([tenantId])
  @@index([placement])
  @@index([targetType])
  @@index([targetStoreId])
  @@index([targetPromotionId])
  @@index([isActive, startsAt, endsAt])
  @@index([priority])
  @@index([deletedAt])
  @@index([createdById])
  @@index([updatedById])
}

model AdCreative {
  id              String           @id @default(cuid())
  campaignId      String
  assetId         String?
  title           String?
  description     String?
  altText         String?
  ctaText         String?
  isActive        Boolean          @default(true)
  sortOrder       Int              @default(0)
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdById     String?
  deletedAt       DateTime?
  updatedById     String?
  asset           FileAsset?       @relation("AdCreativeFileAsset", fields: [assetId], references: [id])
  campaign        AdCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy       User?            @relation("AdCreativeCreatedBy", fields: [createdById], references: [id])
  updatedBy       User?            @relation("AdCreativeUpdatedBy", fields: [updatedById], references: [id])
  analyticsEvents AnalyticsEvent[]

  @@index([campaignId])
  @@index([assetId])
  @@index([isActive, sortOrder])
  @@index([deletedAt])
  @@index([createdById])
  @@index([updatedById])
}

model AnalyticsEvent {
  id            String             @id @default(cuid())
  type          AnalyticsEventType
  source        AnalyticsSource
  sessionId     String?
  panelId       String?
  storeId       String?
  categoryId    String?
  promotionId   String?
  campaignId    String?
  creativeId    String?
  query         String?
  qrToken       String?
  deviceData    Json?
  payload       Json?
  createdAt     DateTime           @default(now())
  adSlotId      String?
  clientEventId String?            @unique
  adSlot        AdSlot?            @relation(fields: [adSlotId], references: [id])
  campaign      AdCampaign?        @relation(fields: [campaignId], references: [id])
  category      Category?          @relation(fields: [categoryId], references: [id])
  creative      AdCreative?        @relation(fields: [creativeId], references: [id])
  panel         Panel?             @relation(fields: [panelId], references: [id])
  promotion     Promotion?         @relation(fields: [promotionId], references: [id])
  store         Store?             @relation(fields: [storeId], references: [id])

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([source, createdAt])
  @@index([sessionId])
  @@index([panelId, createdAt])
  @@index([adSlotId, createdAt])
  @@index([storeId, createdAt])
  @@index([categoryId, createdAt])
  @@index([promotionId, createdAt])
  @@index([campaignId, createdAt])
  @@index([creativeId, createdAt])
}

model FileAsset {
  id                 String         @id @default(cuid())
  filename           String
  originalName       String?
  mimeType           String?
  size               Int?
  url                String
  path               String?
  provider           String?
  metadata           Json?
  uploadedById       String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  isActive           Boolean        @default(true)
  kind               FileAssetKind  @default(OTHER)
  adCreativeAssets   AdCreative[]   @relation("AdCreativeFileAsset")
  uploadedBy         User?          @relation("UploadedFiles", fields: [uploadedById], references: [id])
  floorMaps          Floor[]        @relation("FloorMapAsset")
  floorModels        Floor[]        @relation("FloorModelAsset")
  floorIcons         FloorIcon[]
  floorTextures      FloorTexture[]
  headerBannerAssets HeaderBanner[] @relation("HeaderBannerAsset")
  promotionImages    Promotion[]    @relation("PromotionImageAsset")
  storeCovers        Store[]        @relation("StoreCoverAsset")
  storeLogos         Store[]        @relation("StoreLogoAsset")
  tenantLogos        Tenant[]       @relation("TenantLogoAsset")

  @@index([uploadedById])
  @@index([mimeType])
  @@index([isActive])
  @@index([kind])
  @@index([createdAt])
}

model FloorTexture {
  id           String    @id @default(cuid())
  floorId      String
  assetId      String
  targetMesh   String
  materialSlot String?
  opacity      Float     @default(1)
  blendMode    String    @default("normal")
  positionX    Float     @default(0)
  positionY    Float     @default(0)
  scaleX       Float     @default(1)
  scaleY       Float     @default(1)
  rotation     Float     @default(0)
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  asset        FileAsset @relation(fields: [assetId], references: [id])
  floor        Floor     @relation(fields: [floorId], references: [id], onDelete: Cascade)

  @@index([floorId])
  @@index([assetId])
  @@index([floorId, isActive, sortOrder])
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([isPublic])
}

model SharedRoute {
  id        String   @id @default(cuid())
  token     String   @unique
  payload   Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([token])
  @@index([expiresAt])
}

model FloorIcon {
  id        String        @id @default(cuid())
  name      String
  floorId   String
  storeId   String?
  assetId   String?
  x         Float
  y         Float
  z         Float         @default(0)
  rotation  Float         @default(0)
  scaleX    Float         @default(1)
  scaleY    Float         @default(1)
  sortOrder Int           @default(0)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  type      FloorIconType @default(IMAGE)
  asset     FileAsset?    @relation(fields: [assetId], references: [id])
  floor     Floor         @relation(fields: [floorId], references: [id], onDelete: Cascade)
  store     Store?        @relation(fields: [storeId], references: [id])

  @@index([floorId])
  @@index([storeId])
  @@index([assetId])
}

model AdSlot {
  id              String                 @id @default(cuid())
  code            String                 @unique
  name            String
  description     String?
  placement       AdPlacement
  panelId         String?
  sortOrder       Int                    @default(0)
  isActive        Boolean                @default(true)
  metadata        Json?
  deletedAt       DateTime?
  createdById     String?
  updatedById     String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  assignments     AdCampaignAssignment[]
  createdBy       User?                  @relation("AdSlotCreatedBy", fields: [createdById], references: [id])
  panel           Panel?                 @relation(fields: [panelId], references: [id])
  updatedBy       User?                  @relation("AdSlotUpdatedBy", fields: [updatedById], references: [id])
  analyticsEvents AnalyticsEvent[]

  @@index([placement, isActive, sortOrder])
  @@index([panelId, isActive])
  @@index([deletedAt])
  @@index([createdById])
  @@index([updatedById])
}

model AdCampaignAssignment {
  id          String     @id @default(cuid())
  campaignId  String
  slotId      String
  isActive    Boolean    @default(true)
  deletedAt   DateTime?
  createdById String?
  updatedById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  campaign    AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy   User?      @relation("AdCampaignAssignmentCreatedBy", fields: [createdById], references: [id])
  slot        AdSlot     @relation(fields: [slotId], references: [id], onDelete: Cascade)
  updatedBy   User?      @relation("AdCampaignAssignmentUpdatedBy", fields: [updatedById], references: [id])

  @@unique([campaignId, slotId])
  @@index([campaignId, isActive, deletedAt])
  @@index([slotId, isActive, deletedAt])
  @@index([deletedAt])
  @@index([createdById])
  @@index([updatedById])
}

model HeaderBanner {
  id            String     @id @default(cuid())
  title         String
  subtitle      String?
  linkUrl       String?
  assetId       String?
  isActive      Boolean    @default(true)
  sortOrder     Int        @default(0)
  placement     String     @default("HEADER")
  deletedAt     DateTime?
  createdById   String?
  updatedById   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  targetStoreId String?
  asset         FileAsset? @relation("HeaderBannerAsset", fields: [assetId], references: [id])
  createdBy     User?      @relation("HeaderBannerCreatedBy", fields: [createdById], references: [id])
  targetStore   Store?     @relation("HeaderBannerTargetStore", fields: [targetStoreId], references: [id])
  updatedBy     User?      @relation("HeaderBannerUpdatedBy", fields: [updatedById], references: [id])

  @@index([isActive, sortOrder])
  @@index([placement])
  @@index([deletedAt])
  @@index([createdById])
  @@index([updatedById])
  @@index([targetStoreId])
}

enum PanelStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum MapObjectType {
  STORE
  TOILET
  ATM
  ENTRANCE
  EXIT
  ELEVATOR
  ESCALATOR
  STAIRS
  PARKING
  INFO
  FOODCOURT
  REST_ZONE
  AD_ZONE
}

enum RouteNodeType {
  ROUTE_POINT
  ENTRANCE
  EXIT
  PANEL
  STORE_ANCHOR
  ELEVATOR
  ESCALATOR
  STAIRS
  TOILET
  INFO_DESK
  OTHER
}

enum RouteEdgeType {
  WALKWAY
  ELEVATOR
  ESCALATOR
  STAIRS
  TOILET
  ENTRANCE
  EXIT
  OTHER
}

enum FileAssetKind {
  IMAGE
  VIDEO
  MODEL_3D
  DOCUMENT
  OTHER
}

enum AdPlacement {
  HOME_PANEL_BANNER
  STORE_CARD_BANNER
  PROMOTIONS_BANNER
  MOBILE_HOME_BANNER
}

enum AdTargetType {
  STORE
  PROMOTION
  URL
  NONE
}

enum AnalyticsSource {
  PANEL
  MOBILE
  ADMIN
}

enum AnalyticsEventType {
  SESSION_STARTED
  SESSION_ENDED
  SESSION_RESET
  SEARCH_QUERY
  CATEGORY_SELECTED
  STORE_SELECTED
  STORE_CARD_VIEWED
  ROUTE_BUILT
  QR_SCANNED
  PROMOTION_VIEWED
  AD_IMPRESSION
  AD_CLICK
  MOBILE_OPENED
  PANEL_USED
  DATA_LOAD_ERROR
}

enum FloorIconType {
  IMAGE
  TEXT
}
